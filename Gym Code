// Main Activity is the part that controls the main app through Android

@Composable
// Composable is where I have designed the interface for the app GYM
fun GymApp() {

    var score by remember { mutableIntStateOf(0) }
    var element by remember { mutableIntStateOf(1) }
    var stopped by remember { mutableStateOf(false) }



    Column(
        modifier = Modifier.padding(20.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {

        Text("Gym App")

        Text("Score: $score")

        Text("Element: $element / 10")

        Button(onClick = {
            if (element <= 10) {

                if (element <= 3) {
                    score = score + 1
                } else if (element <= 7) {
                    score = score + 2
                } else {
                    score = score + 3
                }

                element = element + 1
            }
        }) {
            Text("Perform")
        }

        Button(onClick = {
            if (element > 1) {
                score = score - 2
                stopped = true
            }
        }) {
            Text("Deduction")
        }

        Button(onClick = {
            score = 0
            element = 1
            stopped = false
        }) {
            Text("Reset")
        }
    }
}

